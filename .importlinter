[importlinter]
root_package = app

[importlinter:contract:core-isolated]
name = Core should not import features or platform
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.features
ignore_imports =
    # HUP HOP LE (ADR-008): app.adapters.dispatcher la dich vu dispatch chinh thuc,
    # no BUOC phai biet ca 4 adapter nen tang. Moi thu import dispatcher deu keo theo
    # toan bo features — do la thiet ke, khong phai ro ri.
    app.adapters.dispatcher -> app.features.**
    # NO KY THUAT THAT — can vá, dung them cai moi vao day:
    # core khong duoc biet mot nen tang cu the.
    app.core.observability.metrics_checker -> app.features.facebook.pages.reels

[importlinter:contract:features-independent]
name = Features should be independent
type = independence
modules =
    app.features.threads
    app.features.facebook
    app.features.instagram
    app.features.tiktok
    app.features.viral_intake
    app.features.insights
    app.features.affiliates
    app.features.telegram_bot
    app.features.system_panel
    app.features.accounts
    app.features.jobs
    app.features.studio
ignore_imports =
    # HUP HOP LE (ADR-008): di qua dispatcher la cach chinh thuc de mot feature
    # cham toi nen tang khac.
    app.adapters.dispatcher -> app.features.**
    # NO KY THUAT THAT — can vá, dung them cai moi vao day:
    app.core.observability.metrics_checker -> app.features.facebook.pages.reels

# ADR-061: moi buoc Studio lam dung 1 viec — khong buoc nao import buoc khac.
# Chi app.features.studio.pipeline biet thu tu cac buoc.
[importlinter:contract:studio-stages-independent]
name = Studio stages are independent
type = independence
modules =
    app.features.studio.intake
    app.features.studio.analyze
    app.features.studio.dub
    app.features.studio.compose
    app.features.studio.render
    app.features.studio.caption
    app.features.studio.review
    app.features.studio.publish

[importlinter:contract:studio-stages-below-pipeline]
name = Studio stages do not reach up to pipeline / queue / worker
type = forbidden
source_modules =
    app.features.studio.intake
    app.features.studio.analyze
    app.features.studio.dub
    app.features.studio.compose
    app.features.studio.render
    app.features.studio.caption
    app.features.studio.review
    app.features.studio.publish
forbidden_modules =
    app.features.studio.pipeline
    app.features.studio.queue
    app.features.studio.worker
    app.features.studio.entry
    app.features.studio.editor
    app.features.studio.setup
    app.features.studio.router
