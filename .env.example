# -------------------------------------------------------------------------------
# AUTO PUBLISHER - ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# -------------------------------------------------------------------------------

# [SECURITY]
ADMIN_USERNAME=
ADMIN_PASSWORD=
SECRET_KEY=

# Copy this file to '.env' and fill in your actual credentials/paths.
# Map đầy đủ: docs/CONFIG.md
# -------------------------------------------------------------------------------

# [LOCAL DEV]
# WEB_PORT=8002

# [STORAGE LAYOUT]
# storage (default): mọi media/output dưới storage/ — xem docs/CONFIG.md
# legacy: content/, reup_videos/, thumbnails/ ở repo root (chỉ khi migrate cũ)
# STORAGE_LAYOUT_MODE=storage
# STORAGE_DIR=

# [DATABASE]
# Empty by default to use dynamic path resolution relative to app installation.
DB_PATH=
# Postgres chay bang docker-compose.yml (restart: unless-stopped).
#   docker compose up -d
# manage.py db backup dung pg_dump; neu host khong co pg_dump thi fallback
# `docker exec` vao container duoi day.
# POSTGRES_CONTAINER=toolsauto_postgres
# POSTGRES_PORT=5434
# Postgres (default in app/config.py if unset):
# DATABASE_URL=postgresql+psycopg2://admin:admin@127.0.0.1:5434/toolsauto_db

# [TELEGRAM NOTIFICATIONS]
# Get your token from @BotFather and chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# [AI / GEMINI]
# Key dạng AIza… lấy ở https://aistudio.google.com/apikey (không phải OAuth client
# hay service account). Đường caption native, ưu tiên nhất. Kiểm key trước khi bật
# stack: python manage.py ai check
GEMINI_API_KEY=
# GOOGLE_API_KEY= là tên cũ, vẫn đọc được nhưng đừng dùng nữa.

# [AI / OPENAI-COMPATIBLE — OpenRouter hoặc Groq]
# Mặc định trỏ https://openrouter.ai/api/v1, model openrouter/free (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
#
# Groq qua OpenAI-compatible (free 30 RPM / 1.000 RPD, key ở https://console.groq.com/keys):
# OPENROUTER_BASE_URL=https://api.groq.com/openai/v1
# OPENROUTER_API_KEY=gsk_…
# OPENROUTER_MODEL=qwen/qwen3.8-27b

# [GIÁM SÁT — healthchecks.io]
# 3 URL ping (db backup / maintenance / FB publisher) KHÔNG đặt ở .env: dán ở trang
# /app/settings, nhóm "Giam sat". Trống = tắt. Xem ADR-014.

# Optional: CHROME_BINARY=C:\Program Files\Google\Chrome\Application\chrome.exe
# USE_RPA_FALLBACK=true

# [INFRASTRUCTURE]
# VERCEL_REDIRECT_URL=https://vercel-redirect-rho-three.vercel.app
# PM2_LOGS_EXTRA_DIRS=/var/log/pm2:/custom/logs

# [SECURITY]
# Required for POST /health/gemini/cookie-sync (Chrome extension). No hardcoded default.
COOKIE_SYNC_SECRET=change_me_to_something_secure
# Opt-in only: allow GET /login?username=&password= (leaks credentials). Keep false in production.
# ALLOW_QUERY_LOGIN=false
# SQL console writes (UPDATE/INSERT/DELETE). Default off — SELECT still works when authenticated.
# SQL_CONSOLE_WRITES_ENABLED=false
# System panel destructive actions (git reset --hard, pm2 delete all, pm2 restart all). Default off.
# SYSPANEL_DESTRUCTIVE_ENABLED=false

# [WORKER PERFORMANCE]
# WORKER_TICK_SECONDS=20
# MAX_CONCURRENT_ACCOUNTS=2
# SAFE_MODE=false

# [FACEBOOK / PLAYWRIGHT]
# true = Chromium không mở cửa sổ (PM2/xvfb); Facebook có thể hành xử khác — thử nếu cần
FACEBOOK_PLAYWRIGHT_HEADLESS=false

# [FFMPEG PROCESSING]
# FFMPEG_ENABLED=true
# FFMPEG_PROFILE=reels
# FFMPEG_CRF=28
# FFMPEG_WATERMARK_PATH=storage/media/content/watermark.png

# [DRM / COPYRIGHT]
# DRM_ENABLED=true
# DRM_WATERMARK_TEXT=z

# [ALERTS]
# ALERT_COOLDOWN_SEC=600
# ALERT_RAM_PCT_THRESHOLD=85
# ALERT_CHROME_PROC_THRESHOLD=20
